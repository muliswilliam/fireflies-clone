# Postgres connection string. `docker compose up` provides this database on
# host port 5433 so it never collides with a Postgres already on 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/firefly_notes

# Anthropic API key. Required when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Which AI provider generates Transcripts and Summaries: claude | fake.
# Tests and e2e always use fake.
AI_PROVIDER=claude

# Claude model id used by the claude provider.
AI_MODEL=claude-opus-5

# Global cap on non-sample Meetings created in any rolling 24 hours.
MAX_MEETINGS_PER_DAY=50

# Port the server listens on.
PORT=3000
